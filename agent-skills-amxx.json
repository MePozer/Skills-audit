        {
          "id": "prt_0ba94fbf0001Fz92ecc68hE4pg",
          "sessionID": "ses_f456b4d9affeTtcgooYxTG7A0g",
          "messageID": "msg_0ba94f661001BOGSTvTdqJPRU2",
          "type": "tool",
          "callID": "call_01a0ba94fda872b0a3256576207b1b2e",
